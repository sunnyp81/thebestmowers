---
import BaseLayout from '../layouts/BaseLayout.astro';
import HowWeResearch from '../components/HowWeResearch.astro';
import { POWER_TYPE_HUBS, BRAND_HUBS } from '../lib/site';
import { articleSchema } from '../lib/schema';

const title = 'The Best Mowers UK - Independent Lawn Mower Reviews & Buying Guides';
const description = 'Independent, research-led UK lawn mower buying guides. Compare the best cordless, battery, petrol, robot and ride-on mowers from every major brand.';
const datePublished = '2026-05-10';

const schema = [articleSchema({ headline: title, description, url: '/', datePublished })];

const featured = [
  { slug: 'cordless-lawn-mowers', label: 'Cordless lawn mowers', tag: 'Most popular', tagline: 'Quiet, light, no fuel - the default choice for UK gardens under 600 m².' },
  { slug: 'robot-lawn-mowers', label: 'Robot lawn mowers', tag: 'Trending 2026', tagline: 'Set them and forget them. Best for medium lawns and time-poor owners.' },
  { slug: 'petrol-lawn-mowers', label: 'Petrol lawn mowers', tag: 'Big lawns', tagline: 'Still the king for anything over 800 m² or rough wet grass.' },
  { slug: 'electric-lawn-mowers', label: 'Electric lawn mowers', tag: 'Budget pick', tagline: 'Corded mains-powered. Cheapest path to a cleanly cut small lawn.' },
  { slug: 'ride-on-lawn-mowers', label: 'Ride-on lawn mowers', tag: 'Acreage', tagline: 'For lawns over 1000 m². The models worth shortlisting, compared.' },
  { slug: 'hover-lawn-mowers', label: 'Hover lawn mowers', tag: 'Slopes & banks', tagline: 'Float-on-air mowers - best for steep banks and rough lawns.' },
];
---
<BaseLayout {title} {description} {schema}>
  <section class="lawn-stripes border-b border-steel-200">
    <div class="max-w-6xl mx-auto px-4 py-12 md:py-20 grid md:grid-cols-[minmax(0,1.1fr)_minmax(0,1fr)] gap-10 items-center">
      <div>
        <p class="text-sm font-semibold text-grass-800 uppercase tracking-wide mb-3">Independent UK mower guides</p>
        <h1 class="text-4xl md:text-6xl font-extrabold text-grass-900 leading-[1.02]">The right lawn mower for your garden</h1>
        <p class="mt-5 text-lg text-slate-800 max-w-xl leading-relaxed">
          UK buying guides built from manufacturer specifications, verified owner reviews and UK retail pricing, cross-checked so the figures match the box. We specialise in cordless and battery mowers, the default choice for most British gardens.
        </p>
        <div class="mt-8 flex flex-wrap gap-3">
          <a href="/best-battery-powered-lawn-mower-reviews-uk/" class="inline-flex items-center bg-grass-700 hover:bg-grass-800 text-white font-semibold px-5 py-3 rounded-[4px] min-h-[44px]">Best cordless mowers 2026</a>
          <a href="/research/" class="inline-flex items-center bg-white border-2 border-grass-800 hover:bg-grass-50 text-grass-900 font-semibold px-5 py-3 rounded-[4px] min-h-[44px]">Compare the spec data</a>
        </div>
      </div>
      <img src="/images/ai-home-hero.webp" alt="Cordless lawn mower cutting a striped lawn in a British back garden" width="1200" height="686" class="w-full rounded-[4px] object-cover border-4 border-white" loading="eager" fetchpriority="high" />
    </div>
  </section>

  <section class="max-w-6xl mx-auto px-4 py-16">
    <h2 class="text-2xl md:text-3xl font-bold text-soil-900 mb-2">Browse by power type</h2>
    <p class="text-slate-600 mb-6">Start with how the mower is powered; each guide then narrows by lawn size and budget.</p>
    <ul class="border-t-2 border-grass-800">
      {featured.map((f) => (
        <li class="border-b border-steel-200">
          <a href={`/${f.slug}/`} class="group grid md:grid-cols-[16rem_minmax(0,1fr)_auto] gap-x-6 gap-y-1 items-baseline py-5 px-1 hover:bg-stripe-light">
            <span class="font-display text-xl font-bold text-soil-900 group-hover:text-grass-800 group-hover:underline underline-offset-4">{f.label}</span>
            <span class="text-slate-700 leading-relaxed"><span class="text-xs font-bold uppercase tracking-wide text-grass-800 mr-2">{f.tag}</span>{f.tagline}</span>
            <span class="text-grass-800 font-semibold text-sm whitespace-nowrap" aria-hidden="true">Read the guide →</span>
          </a>
        </li>
      ))}
    </ul>
  </section>

  <section class="bg-stripe-light border-y border-steel-200 py-16">
    <div class="max-w-6xl mx-auto px-4">
      <h2 class="text-2xl md:text-3xl font-bold text-soil-900 mb-6">By brand</h2>
      <div class="flex flex-wrap gap-2">
        {BRAND_HUBS.map((b) => (
          <a href={`/brands/${b}/`} class="bg-white border border-steel-200 hover:border-grass-700 hover:text-grass-800 px-4 py-2.5 rounded-[4px] text-sm font-medium capitalize">{b.replace('-', ' ')}</a>
        ))}
      </div>
    </div>
  </section>

  <section class="max-w-5xl mx-auto px-4 py-16">
    <div class="rounded-[4px] bg-grass-800 text-white p-8 md:p-12">
      <p class="text-sm font-semibold uppercase tracking-wide text-grass-100 mb-2">Start here</p>
      <h2 class="text-2xl md:text-4xl font-bold mb-3">Best Cordless &amp; Battery Lawn Mowers UK 2026</h2>
      <p class="text-grass-50 max-w-2xl leading-relaxed mb-6">
        Nine cordless mowers compared on voltage, cutting width, battery, runtime, weight and price, ranked by who each one suits. Our most complete guide.
      </p>
      <a href="/best-battery-powered-lawn-mower-reviews-uk/" class="inline-flex items-center bg-white text-grass-900 font-semibold px-6 py-3 rounded-[4px] hover:bg-grass-50 min-h-[44px]">Read the guide →</a>
    </div>
  </section>

  <section class="max-w-4xl mx-auto px-4 pb-16">
    <HowWeResearch heading="How we choose" />
  </section>
</BaseLayout>
