---
import { AFFILIATE_REL, amazonLink, amazonSearch } from '../lib/affiliate';
import type { CtaPick } from '../data/ctaPicks';
// Compact pick: name, who it is for, two or three existing pros, review link and a tagged buy link. No price, no rating.
interface Props { pick: CtaPick; label?: string }
const { pick, label } = Astro.props as Props;
const buyUrl = (pick.asin && amazonLink(pick.asin)) || amazonSearch(pick.query ?? `${pick.name} lawn mower`);
const here = Astro.url.pathname.replace(/\/?$/, '/');
const isBrandHub = pick.reviewUrl.startsWith('/brands/');
const showReview = pick.reviewUrl !== here;
---
<article class="border border-steel-200 border-t-4 border-t-grass-700 rounded-[4px] bg-white p-4 flex flex-col">
  <span class="text-xs font-semibold text-grass-700 uppercase tracking-wide mb-1">{label ?? `Best for ${pick.bestFor}`}</span>
  <h3 class="text-lg font-bold text-soil-900 leading-tight">{pick.name}</h3>
  <p class="text-sm text-slate-500 mb-2">{pick.brand}{label ? ` - best for ${pick.bestFor}` : ''}</p>
  <ul class="space-y-0.5 text-sm text-slate-700 mb-3">{pick.pros.map((p) => (<li>+ {p}</li>))}</ul>
  <div class="mt-auto flex flex-wrap items-center gap-2">
    {showReview && <a href={pick.reviewUrl} class="text-sm font-semibold text-grass-700 hover:text-grass-900 underline underline-offset-2">{isBrandHub ? `See the ${pick.brand} range →` : 'Read full review →'}</a>}
    <a href={buyUrl} rel={AFFILIATE_REL} target="_blank" class="btn-buy ml-auto inline-flex items-center gap-1 text-sm font-semibold bg-grass-700 hover:bg-grass-800 text-white px-4 py-2 rounded-[4px] min-h-[44px]">Check price on Amazon →</a>
  </div>
</article>
